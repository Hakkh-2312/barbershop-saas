# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Supabase Postgres connection string) ---
# Get this from Supabase > Project Settings > Database > Connection string (URI, use "Session pooler" for local dev)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme_generate_a_real_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- CORS (comma-separated origins allowed to call this API) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Logging / error monitoring ---
LOG_LEVEL=INFO
# Get this from Sentry once you've created a project (Project Settings > Client Keys)
SENTRY_DSN=

# --- Meta WhatsApp Cloud API ---
# Any string you make up - paste the same value into Meta's webhook config
# (generate with: python -c "import secrets; print(secrets.token_hex(16))")
WHATSAPP_VERIFY_TOKEN=
# From your app's WhatsApp > API Setup page
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Dashboard > Settings > Basic > App Secret. Used to verify incoming
# webhook POSTs really came from Meta. Leave blank to disable that check
# (a warning is logged on every request while it's blank).
WHATSAPP_APP_SECRET=
# id of the Tenant this WhatsApp number belongs to (until multi-tenant
# WhatsApp routing exists). Leave blank to keep the static "coming soon" reply.
WHATSAPP_TENANT_ID=

# --- Internal scheduled jobs (e.g. the daily appointment-reminder run) ---
# A shared secret an external cron-ping service (e.g. cron-job.org) must
# send to trigger POST/GET /api/internal/send-reminders. There's no logged-in
# user for this kind of request, so it can't use normal JWT auth.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_TASK_SECRET=

# --- Billing (Stripe) ---
# Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks -> (your endpoint) -> Signing secret.
STRIPE_WEBHOOK_SECRET=
# The one subscription plan's Price id (not the Product id) - Dashboard ->
# Product catalog -> your product -> the price row.
STRIPE_PRICE_ID=
# The deployed dashboard's own URL - where Stripe sends the shop owner back
# after Checkout/the Customer Portal.
DASHBOARD_URL=http://localhost:3000
TRIAL_PERIOD_DAYS=14
